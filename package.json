{
  "name": "dalean-desktop",
  "version": "1.0.0",
  "description": "DaLean - Smart Data Cleaning Platform for Desktop",
  "author": "DaLean Team",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "i18next": "^25.4.2",
    "lodash": "^4.17.21",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-data-grid": "^7.0.0-beta.56",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.7.1",
    "react-scripts": "^5.0.1",
    "recharts": "^3.1.0",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "set ELECTRON_IS_DEV=true && electron .",
    "electron-pack": "npm run build && electron-builder",
    "preelectron-pack": "npm run build",
    "dist": "npm run build && electron-builder --publish=never"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14"
  },
  "build": {
    "appId": "com.dalean.app",
    "productName": "DaLean",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron.js"
    ],
    "extraMetadata": {
      "main": "electron.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/logo512.png"
    },
    "win": {
      "target": "dir",
      "icon": "build/logo512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/logo512.png"
    },
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false
  }
}
